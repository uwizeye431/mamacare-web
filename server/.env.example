# Copy this file to server/.env and fill in the values. Never commit server/.env.

# --- Required -------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/mamacare

# Two DIFFERENT random strings, at least 32 characters each. The server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Server ---------------------------------------------------------------
PORT=5000
# development | production
NODE_ENV=development
# Comma-separated list of web app origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# Number of proxies in front of the API, so rate limiting sees each visitor's real IP:
# 0 locally, 1 on Render, 2 when the website also forwards /api to the API
TRUST_PROXY=0

# --- Email (verification and password reset codes) --------------------------
# Option A (recommended for production): Resend, sends over HTTPS. Works on hosts that block SMTP.
# FROM_EMAIL must be on a domain you verified in Resend (onboarding@resend.dev works for testing).
RESEND_API_KEY=
FROM_EMAIL=noreply@your-domain.com

# Option B: SMTP (e.g. Gmail with an app password). Used when RESEND_API_KEY is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Inbox notified about new contact-form messages (defaults to SMTP_USER).
# Messages are also stored and readable in the admin area.
CONTACT_RECEIVER_EMAIL=

# --- Error monitoring (optional) ----------------------------------------
# Sentry project DSN for the API. Leave empty to disable. Reports never include request bodies or user details.
SENTRY_DSN=
