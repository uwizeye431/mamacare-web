# Copy this file to .env.local (web app) and fill in the values. Never commit .env.local.

# How the website reaches the Express API. Choose ONE:
# a) Direct (local development): the API's URL. Baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:5000
# b) Forwarding (recommended in production): leave NEXT_PUBLIC_API_URL empty and set the API's URL here.
#    The website forwards /api/* to the API, so login cookies work in every browser, including Safari.
API_PROXY_URL=

# Public address of the website (sitemap, robots.txt, link previews), e.g. https://mamacare.rw
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Error monitoring (optional) ----------------------------------------
# Sentry project DSN. Leave empty to disable. Reports never include request bodies or user details.
NEXT_PUBLIC_SENTRY_DSN=
